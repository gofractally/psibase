# Validate the exact source files qualified by the native dependency adapters.
include_guard(GLOBAL)

function(psibase_check_dependency_tree source manifest)
    file(STRINGS "${manifest}" expected)
    set(expected_paths)
    set(scopes)
    foreach(entry IN LISTS expected)
        string(SUBSTRING "${entry}" 0 64 digest)
        string(SUBSTRING "${entry}" 66 -1 relative)
        list(APPEND expected_paths "${relative}")
        if(relative MATCHES "^(libraries/[^/]+|include)/")
            list(APPEND scopes "${CMAKE_MATCH_1}")
        else()
            list(APPEND scopes "${relative}")
        endif()
        if(NOT EXISTS "${source}/${relative}")
            message(FATAL_ERROR "Pinned dependency file missing: ${source}/${relative}")
        endif()
        file(SHA256 "${source}/${relative}" actual)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}/${relative}")
        if(NOT actual STREQUAL digest)
            message(FATAL_ERROR "Pinned dependency file changed: ${source}/${relative}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES scopes)
    set(actual_paths)
    foreach(scope IN LISTS scopes)
        if(IS_DIRECTORY "${source}/${scope}")
            file(GLOB_RECURSE entries CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/${scope}/*")
            list(APPEND actual_paths ${entries})
        else()
            list(APPEND actual_paths "${scope}")
        endif()
    endforeach()
    list(SORT actual_paths)
    list(SORT expected_paths)
    if(NOT actual_paths STREQUAL expected_paths)
        message(FATAL_ERROR "Pinned dependency source file set changed in ${source}")
    endif()
endfunction()
