# One qualified UCC target is shared by the storage and native VM adapters.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PsibaseDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PsibaseDependencyValidation.cmake")

function(psibase_add_ucc)
    psibase_acquire_dependency(ucc)
    psibase_check_dependency_tree("${ucc_SOURCE_DIR}"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies/ucc-files.sha256")
    get_filename_component(canonical_source "${ucc_SOURCE_DIR}" REALPATH)
    get_property(owned_source GLOBAL PROPERTY PSIBASE_UCC_SOURCE_DIR)
    if(TARGET ucc OR TARGET ucc::ucc)
        if(NOT owned_source STREQUAL canonical_source)
            message(FATAL_ERROR "psibase must own its qualified canonical UCC target")
        endif()
    else()
        set(UCC_ENABLE_TESTS OFF)
        add_subdirectory("${ucc_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/psibase-deps/ucc")
        set_property(GLOBAL PROPERTY PSIBASE_UCC_SOURCE_DIR "${canonical_source}")
    endif()
    if(NOT TARGET ucc OR NOT TARGET ucc::ucc)
        message(FATAL_ERROR "Canonical UCC did not provide ucc and ucc::ucc")
    endif()
    get_target_property(aliased ucc::ucc ALIASED_TARGET)
    get_target_property(target_source ucc SOURCE_DIR)
    get_target_property(target_type ucc TYPE)
    get_target_property(target_includes ucc INTERFACE_INCLUDE_DIRECTORIES)
    get_filename_component(target_source "${target_source}" REALPATH)
    set(expected_includes "$<BUILD_INTERFACE:${ucc_SOURCE_DIR}/include>;$<INSTALL_INTERFACE:include>")
    if(NOT aliased STREQUAL "ucc" OR NOT target_type STREQUAL "INTERFACE_LIBRARY" OR
       NOT target_source STREQUAL canonical_source OR NOT target_includes STREQUAL expected_includes)
        message(FATAL_ERROR "Canonical UCC target source or include identity changed")
    endif()
    set(ucc_SOURCE_DIR "${ucc_SOURCE_DIR}" PARENT_SCOPE)
endfunction()
