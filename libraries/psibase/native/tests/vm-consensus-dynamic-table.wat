;; Correctness only: dynamically stored function references retain type/index
;; and native entry points, including imported host functions.
(module
  (type $integer (func (param i32) (result i32)))
  (type $wide (func (param i64) (result i64)))
  (type $record-type (func (param i32 i64)))
  (type $void (func))
  (import "consensus" "record" (func $record (type $record-type)))
  (import "consensus" "fail" (func $fail (type $void)))
  (memory 1)
  (table 1 8 funcref)
  (func $identity (type $integer) (param i32) (result i32)
    local.get 0 i32.const 0x13579bdf i32.xor)
  (func $wide-func (type $wide) (param i64) (result i64)
    local.get 0 i64.const 1 i64.add)
  (elem (i32.const 0) $identity)
  (elem declare func $wide-func $record $fail)
  (func (export "size") (result i32) table.size)
  (func (export "set_identity") (param i32) local.get 0 ref.func $identity table.set)
  (func (export "set_record") (param i32) local.get 0 ref.func $record table.set)
  (func (export "set_wide") (param i32) local.get 0 ref.func $wide-func table.set)
  (func (export "set_fail") (param i32) local.get 0 ref.func $fail table.set)
  (func (export "set_null") (param i32) local.get 0 ref.null func table.set)
  (func (export "fill_identity") (param i32 i32)
    local.get 0 ref.func $identity local.get 1 table.fill)
  (func (export "fill_record") (param i32 i32)
    local.get 0 ref.func $record local.get 1 table.fill)
  (func (export "fill_wide") (param i32 i32)
    local.get 0 ref.func $wide-func local.get 1 table.fill)
  (func (export "fill_null") (param i32 i32)
    local.get 0 ref.null func local.get 1 table.fill)
  (func (export "grow_identity") (param i32) (result i32)
    ref.func $identity local.get 0 table.grow)
  (func (export "grow_record") (param i32) (result i32)
    ref.func $record local.get 0 table.grow)
  (func (export "grow_null") (param i32) (result i32)
    ref.null func local.get 0 table.grow)
  (func (export "call_integer") (param i32 i32) (result i32)
    local.get 0 local.get 1 call_indirect (type $integer))
  (func (export "call_wide") (param i64 i32) (result i64)
    local.get 0 local.get 1 call_indirect (type $wide))
  (func (export "call_record") (param i32 i32 i64)
    local.get 1 local.get 2 local.get 0 call_indirect (type $record-type))
  (func (export "call_fail") (param i32)
    local.get 0 call_indirect (type $void))
)
