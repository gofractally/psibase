;; Correctness-only consensus fixtures. Never used as performance workloads.
(module
  (import "consensus" "record" (func $record (param i32 i64)))
  (memory (export "memory") 1 3)
  (type $identity-type (func (param i32) (result i32)))
  (table 1 8 funcref)
  (global $counter (mut i32) (i32.const 7))
  (global $wide (mut i64) (i64.const 0x1122334455667788))
  (global $single (mut f32) (f32.const -nan:0x12345))
  (global $double (mut f64) (f64.const nan:0x8123456789abc))
  (global $vector (mut v128) (v128.const i32x4 0x7fc12345 0x80000000 1 0xff800001))
  (data (i32.const 64) "consensus-state")
  (func $identity (type $identity-type) (param i32) (result i32) local.get 0)
  (elem (i32.const 0) $identity)
  (func $boot global.get $counter i32.const 1 i32.add global.set $counter i32.const 1 global.get $counter i64.extend_i32_u call $record)
  (start $boot)
  (func (export "f32_add_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.add i32.reinterpret_f32)
  (func (export "f32_sub_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.sub i32.reinterpret_f32)
  (func (export "f32_mul_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.mul i32.reinterpret_f32)
  (func (export "f32_div_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.div i32.reinterpret_f32)
  (func (export "f32_min_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.min i32.reinterpret_f32)
  (func (export "f32_max_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.max i32.reinterpret_f32)
  (func (export "f32_copysign_bits") (param i32 i32) (result i32) local.get 0 f32.reinterpret_i32 local.get 1 f32.reinterpret_i32 f32.copysign i32.reinterpret_f32)
  (func (export "f32_abs_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.abs i32.reinterpret_f32)
  (func (export "f32_neg_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.neg i32.reinterpret_f32)
  (func (export "f32_sqrt_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.sqrt i32.reinterpret_f32)
  (func (export "f32_ceil_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.ceil i32.reinterpret_f32)
  (func (export "f32_floor_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.floor i32.reinterpret_f32)
  (func (export "f32_trunc_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.trunc i32.reinterpret_f32)
  (func (export "f32_nearest_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 f32.nearest i32.reinterpret_f32)
  (func (export "f32_reinterpret_bits") (param i32) (result i32) local.get 0 f32.reinterpret_i32 i32.reinterpret_f32)
  (func (export "f64_add_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.add i64.reinterpret_f64)
  (func (export "f64_sub_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.sub i64.reinterpret_f64)
  (func (export "f64_mul_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.mul i64.reinterpret_f64)
  (func (export "f64_div_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.div i64.reinterpret_f64)
  (func (export "f64_min_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.min i64.reinterpret_f64)
  (func (export "f64_max_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.max i64.reinterpret_f64)
  (func (export "f64_copysign_bits") (param i64 i64) (result i64) local.get 0 f64.reinterpret_i64 local.get 1 f64.reinterpret_i64 f64.copysign i64.reinterpret_f64)
  (func (export "f64_abs_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.abs i64.reinterpret_f64)
  (func (export "f64_neg_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.neg i64.reinterpret_f64)
  (func (export "f64_sqrt_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.sqrt i64.reinterpret_f64)
  (func (export "f64_ceil_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.ceil i64.reinterpret_f64)
  (func (export "f64_floor_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.floor i64.reinterpret_f64)
  (func (export "f64_trunc_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.trunc i64.reinterpret_f64)
  (func (export "f64_nearest_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 f64.nearest i64.reinterpret_f64)
  (func (export "f64_reinterpret_bits") (param i64) (result i64) local.get 0 f64.reinterpret_i64 i64.reinterpret_f64)
  (func (export "f32x4_add") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.add)
  (func (export "f32x4_sub") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.sub)
  (func (export "f32x4_mul") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.mul)
  (func (export "f32x4_div") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.div)
  (func (export "f32x4_min") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.min)
  (func (export "f32x4_max") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.max)
  (func (export "f32x4_pmin") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.pmin)
  (func (export "f32x4_pmax") (param v128 v128) (result v128) local.get 0 local.get 1 f32x4.pmax)
  (func (export "f32x4_abs") (param v128) (result v128) local.get 0 f32x4.abs)
  (func (export "f32x4_neg") (param v128) (result v128) local.get 0 f32x4.neg)
  (func (export "f32x4_sqrt") (param v128) (result v128) local.get 0 f32x4.sqrt)
  (func (export "f32x4_ceil") (param v128) (result v128) local.get 0 f32x4.ceil)
  (func (export "f32x4_floor") (param v128) (result v128) local.get 0 f32x4.floor)
  (func (export "f32x4_trunc") (param v128) (result v128) local.get 0 f32x4.trunc)
  (func (export "f32x4_nearest") (param v128) (result v128) local.get 0 f32x4.nearest)
  (func (export "f64x2_add") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.add)
  (func (export "f64x2_sub") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.sub)
  (func (export "f64x2_mul") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.mul)
  (func (export "f64x2_div") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.div)
  (func (export "f64x2_min") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.min)
  (func (export "f64x2_max") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.max)
  (func (export "f64x2_pmin") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.pmin)
  (func (export "f64x2_pmax") (param v128 v128) (result v128) local.get 0 local.get 1 f64x2.pmax)
  (func (export "f64x2_abs") (param v128) (result v128) local.get 0 f64x2.abs)
  (func (export "f64x2_neg") (param v128) (result v128) local.get 0 f64x2.neg)
  (func (export "f64x2_sqrt") (param v128) (result v128) local.get 0 f64x2.sqrt)
  (func (export "f64x2_ceil") (param v128) (result v128) local.get 0 f64x2.ceil)
  (func (export "f64x2_floor") (param v128) (result v128) local.get 0 f64x2.floor)
  (func (export "f64x2_trunc") (param v128) (result v128) local.get 0 f64x2.trunc)
  (func (export "f64x2_nearest") (param v128) (result v128) local.get 0 f64x2.nearest)
  (func (export "f32_demote_bits") (param i64) (result i32) local.get 0 f64.reinterpret_i64 f32.demote_f64 i32.reinterpret_f32)
  (func (export "f64_promote_bits") (param i32) (result i64) local.get 0 f32.reinterpret_i32 f64.promote_f32 i64.reinterpret_f64)
  (func (export "trunc_sat_f32_s") (param i32) (result i32) local.get 0 f32.reinterpret_i32 i32.trunc_sat_f32_s)
  (func (export "trunc_sat_f64_s") (param i64) (result i64) local.get 0 f64.reinterpret_i64 i64.trunc_sat_f64_s)
  (func (export "simd_trunc_sat") (param v128) (result v128) local.get 0 i32x4.trunc_sat_f32x4_s)
  (func (export "mutate") (param $a i32) (param $b i64) (result i64)
    global.get $counter i32.const 1 i32.add global.set $counter
    local.get $b global.set $wide
    local.get $a f32.reinterpret_i32 global.set $single
    local.get $b f64.reinterpret_i64 global.set $double
    i32.const 7 local.get $a i32.store align=1
    i32.const 29 local.get $b i64.store align=1
    i32.const 96 local.get $a i32.store
    i32.const 100 global.get $counter i32.store
    i32.const 104 local.get $b i64.store
    i32.const 96 v128.load global.set $vector
    i32.const 200 i32.const 90 i32.const 32 memory.fill
    i32.const 256 i32.const 200 i32.const 32 memory.copy
    i32.const 2 local.get $b call $record
    local.get $b global.get $counter i64.extend_i32_u i64.xor)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow)
  (func (export "pages") (result i32) memory.size)
  (func (export "table_grow") (param i32) (result i32) ref.func $identity local.get 0 table.grow)
  (func (export "table_size") (result i32) table.size)
  (func (export "indirect") (param i32 i32) (result i32) local.get 0 local.get 1 call_indirect (type $identity-type))
)
