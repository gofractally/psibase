package x-portal:plugin;

interface api {
    use host:types/types.{error};
    use auth-scope:plugin/api.{allowed-action};

    /// In one transaction, creates `ac-creator` owned by `owner` and has it enable tokens auto-debit.
    /// Only callable by `x-portal`.
    create-admin-accounts: func(pubkey-pem: string, owner: string, allowed: list<allowed-action>) -> result<_, error>;
}

world impl {
    include host:client/imports;
    include host:types/imports;
    import auth-scope:plugin/api;
    import transact:plugin/api;
    import tokens:plugin/user-config;
    export api;
}
