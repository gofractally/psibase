package accounts:plugin;

/// This is the typical API
interface api {
    use host:types/types.{error};

    /// Sets the auth service used to authenticate the currently logged-in user
    /// Currently calling this is restricted.
    set-auth-service: func(service-name: string) -> result<_, error>;

    /// Executes a GraphQL query against this app's http server.
    ///
    /// Arguments
    /// * `query` - GraphQL query to execute
    ///
    /// Returns the result of the query as a string.
    graphql: func(query: string) -> result<string, error>;
}

/// This interface is only callable by the accounts app itself.
interface admin {
    use host:types/types.{error};

    /// Get a list of auth accounts
    get-auth-services: func() -> result<list<string>, error>;

    /// preapprove an account for creation within this transaction
    preapprove-account: func(account: string);

    /// Schedule a freeze of these accounts.
    freeze: func(accounts: list<string>, memo: string) -> result<_, error>;

    /// Schedule an unfreeze of these accounts.
    unfreeze: func(accounts: list<string>, memo: string) -> result<_, error>;
}

world imports {
    import api;
}
