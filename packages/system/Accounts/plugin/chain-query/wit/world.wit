package accounts:chain-query;

interface types {
    record account {
        account-num: string,
        auth-service: string,
    }
}

interface api {
    use host:types/types.{error};
    use types.{account};

    /// Gets the account details for the specified account name.
    /// Possible responses:
    /// - Some(Account) - The account name is valid and exists with specified details
    /// - None - The account name is valid but has not been created
    /// - [Error] InvalidAccountName - The account name is not a valid psibase account name
    get-account: func(name: string) -> result<option<account>, error>;

    /// Generates a random account number not in use on the network
    /// Supports optional prefix of up to 9 chars, must not start with "x-"
    gen-rand-account: func(prefix: option<string>) -> result<string, error>;
}

world imports {
    import api;
}
