package auth-delegate:plugin;

interface session {
    use host:types/types.{error, pem};

    /// Adds `account-name` to the accounts known on this device after verifying that
    /// `private-key` can authorize it.
    ///
    /// Can only be called by `host`.
    add-account: func(account-name: string, private-key: pem) -> result<_, error>;

    /// Called by the supervisor at the start of every transaction for
    /// the currently logged-in user.
    authorize: func(account-name: string) -> result<_, error>;

    /// Log `account-name` into the currently active app.
    ///
    /// Can only be called by `host`.
    login: func(account-name: string) -> result<_, error>;
}

world impl {
    include host:client/imports;
    include host:http/imports;
    include transact:plugin/imports;
    include permissions:plugin/imports;

    export session;
    export api;
    export queries;
}
