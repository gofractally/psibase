package auth-sig:plugin;

/// Methods related to key management
interface keyvault {
    use host:types/types.{error, pem, keypair};

    /// Generates a new keypair that is unmanaged (nothing is stored).
    /// The full keypair is returned to the caller.
    generate-unmanaged-keypair: func() -> result<keypair, error>;

    /// Returns the public key corresponding to the specified
    /// private key.
    pub-from-priv: func(private-key: pem) -> result<pem, error>;

    /// Returns the DER encoded key
    to-der: func(key: pem) -> result<list<u8>, error>;

    /// Signs a pre-hashed message with the private key corresponding to the specified DER-encoded public key
    sign: func(hashed-message: list<u8>, public-key: list<u8>) -> result<list<u8>, error>;

    /// Signs a pre-hashed message with the specified DER-encoded private key
    sign-explicit: func(hashed-message: list<u8>, private-key: list<u8>) -> result<list<u8>, error>;

    /// Imports a PEM-encoded private key into the keyvault.
    /// This does not change the key of any account, it simply allows AuthSig to sign
    ///   with the specified private key.
    /// Returns the corresponding public key in PEM format.
    import-key: func(private-key: pem) -> result<pem, error>;
}

interface actions {
    use host:types/types.{error, pem};

    /// Updates the key used by the current user to the specified public key
    /// The specified public key should be the PEM representation of the public key
    set-key: func(public-key: pem) -> result<_, error>;

    /// Creates a new account with the specified name.
    /// This can only be called if there is already a logged-in user
    /// 
    /// The private key of the new account is returned to the caller, and is not yet 
    /// imported onto this device. To import, the caller must explicitly call `keyvault:import-key`.
    create-account: func(new-account-name: string) -> result<string, error>;

    /// Schedules the creation of an account with the specified owner and active keys.
    /// The current user sends it and so becomes the new account's recovery partner.
    /// Nothing is stored on this device.
    ///
    /// The keys are DER SubjectPublicKeyInfo as hex, as the sign-in page and x-signup
    /// write them; `owner-seq` and `active-seq` are the sequence values the keys were
    /// derived with.
    ///
    /// Callable only by `supervisor` and `host`.
    create-account-with: func(name: string, owner-key: string, owner-seq: u64, active-key: string, active-seq: u64) -> result<_, error>;
}

/// What an account does as the recovery partner of other accounts. Each schedules
/// the auth-sig action of the same name from the current user.
interface partner {
    use host:types/types.{error};

    /// The pending change of `account` takes effect now.
    confirm: func(account: string) -> result<_, error>;

    /// The pending change of `account` is dropped.
    reject: func(account: string) -> result<_, error>;

    /// Ends a pause of `account` that has no pending change.
    end-pause: func(account: string) -> result<_, error>;

    /// Installs the keys of a recovery request in `account`, which is frozen.
    unfreeze: func(account: string, request-id: u32) -> result<_, error>;

    /// Drops a recovery request of `account`.
    reject-recovery: func(account: string, request-id: u32) -> result<_, error>;
}

interface api {
    use host:types/types.{pem};

    /// Checks if the specified private key can authorize the specified account.
    can-authorize: func(private-key: pem, account-name: string) -> bool;
}

interface queries {
    use host:types/types.{error, pem};

    /// Gets the public key of the specified account, or none if it has no auth-sig key.
    get-pubkey: func(account: string) -> result<option<pem>, error>;

    /// Gets the accounts whose auth-sig key is the specified public key.
    get-accounts-with-key: func(public-key: pem) -> result<list<string>, error>;
}

world imports {
    import keyvault;
    import actions;
    import api;
    import queries;
    import partner;
}