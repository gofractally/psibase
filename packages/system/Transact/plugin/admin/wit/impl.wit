package transact:admin;

interface hook-handlers {
    use host:types/types.{error, plugin-ref};
    use transact:plugin/types.{claim, proof};

    on-user-auth-claim: func(plugin: plugin-ref, account-name: string) -> result<option<claim>, error>;
    on-user-auth-proof: func(plugin: plugin-ref, account-name: string, transaction-hash: list<u8>) -> result<option<proof>, error>;
}

world impl {
    include host:client/imports;
    include host:http/imports;
    include host:db/imports;
    include host:crypto/imports;
    include accounts:query/imports;
    include permissions:plugin/imports;

    import transact:plugin/ledger;
    import virtual-server:plugin/preflight;

    import hook-handlers;

    export admin;
}
