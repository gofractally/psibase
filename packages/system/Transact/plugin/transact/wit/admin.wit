package transact:plugin;

interface admin {
    use host:types/types.{error};
    use transact:actions/types.{action};

    /// Opens a new tx context. Adding actions using add-action-to-transaction will
    /// refer to this open context.
    start-tx: func();

    /// Closes the current transaction context, constructs and submits the final
    /// signed transaction.
    finish-tx: func() -> result<_, error>;

    /// Submit the given actions as a single staged transaction proposed by the
    /// logged-in user. Only callable by the `packages` plugin.
    ///
    /// * `actions`: The actions to propose.
    /// * `auto-exec`: If true, the staged transaction will execute as soon as it
    ///                has enough approvals.
    propose: func(actions: list<action>, auto-exec: bool) -> result<_, error>;
}
