package transact:plugin;

interface hook-handlers {
    use host:types/types.{error, plugin-ref};

    on-actions-sender: func(plugin: plugin-ref, service: string, method: string) -> result<option<string>, error>;
}

world impl {
    include host:client/imports;
    include host:http/imports;
    include host:db/imports;
    include host:types/imports;
    include host:crypto/imports;
    include host:accounts/imports;
    include permissions:plugin/imports;

    import hook-handlers;

    export api;
    export hooks;
    export types;
    export auth;
    export authorized;
    export network;
}
