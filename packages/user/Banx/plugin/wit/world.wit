package banx:plugin;

interface types {
    /// Hop used for `path-pay` execution (account + asset only).
    record path-hop {
        account: string,
        asset-id: u16,
    }

    /// Quoted hop with expected fee breakdown (from `quote-path`).
    record path-hop-quote {
        account: string,
        asset-id: u16,
        /// Notional drawn on this hop after fees (human decimal, hop asset).
        amount: string,
        /// Routing fee on this hop (human decimal, hop asset). `"0"` for hop 0.
        hop-fee: string,
        /// FX fixed fee when converting into this hop (human decimal, prior asset).
        /// `"0"` if no asset change.
        fx-fee: string,
        /// Prior asset id when FX convert happened; none otherwise.
        fx-from-asset: option<u16>,
    }

    /// Result of off-chain multi-hop path discovery for `path-pay`.
    record path-quote {
        hops: list<path-hop-quote>,
        /// Amount to draw on the first hop (human decimal in first hop asset).
        amount-in: string,
        /// Estimated amount_out after fees (human decimal in last hop asset).
        amount-out: string,
        /// Suggested min-return for `path-pay` (human decimal in last hop asset).
        min-return: string,
    }

    /// Token + id from `create-invite` (token is the claim-URL secret).
    record created-invite {
        invite-token: string,
        invite-id: u32,
    }
}

interface helpers {
    use host:types/types.{error};

    /// Convert a human decimal string (e.g. `"1.45"`) to raw quantity units for `asset-id`.
    /// Looks up asset precision via Banx GraphQL.
    /// Fractions may not exceed the asset's precision; shorter fractions are padded.
    decimal-to-quantity: func(asset-id: u16, amount: string) -> result<u64, error>;

    /// Convert raw quantity units to a decimal string for `asset-id` (e.g. `14500` → `"1.4500"` at 4 dp).
    quantity-to-decimal: func(asset-id: u16, amount: u64) -> result<string, error>;
}

interface api {
    use host:types/types.{error};
    use types.{path-hop, path-hop-quote, path-quote, created-invite};

    /// Creditor posts/updates a credit line to `debtor` in `asset-id`.
    /// `limit` is a human decimal string (e.g. `"100.00"`).
    /// `interest-rate-ppm` is APR in ppm (10000 = 1%).
    /// `grace-seconds` is the interest-free window after a 0→positive cycle
    /// (`604800` = 7 days). `0` = interest from the first second.
    set-credit-line: func(
        debtor: string,
        asset-id: u16,
        limit: string,
        deplete-on-debit: bool,
        interest-rate-ppm: u32,
        grace-seconds: u32,
    ) -> result<_, error>;

    /// Remove the sender's credit line to `debtor`. Limit 0 is still a line
    /// (known counterparty); this deletes the row.
    remove-credit-line: func(debtor: string, asset-id: u16) -> result<_, error>;

    /// Debtor (sender) lets `creditor` book deposits onto them, up to
    /// `remaining` (human decimal). `max-interest-rate-ppm` 0 = interest-free
    /// only. `expires-at-seconds` 0 = never.
    set-book-auth: func(
        creditor: string,
        asset-id: u16,
        remaining: string,
        max-interest-rate-ppm: u32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Revoke the sender's book-auth to `creditor`.
    remove-book-auth: func(creditor: string, asset-id: u16) -> result<_, error>;

    /// Creditor (sender) books `amount` onto `debtor` under their live
    /// book-auth. Same book as deposit. `memo` max 80 bytes.
    book: func(
        debtor: string,
        asset-id: u16,
        amount: string,
        interest-rate-ppm: u32,
        memo: string,
    ) -> result<_, error>;

    /// Post a path-forward offer toward a **specific** next hop. Prefer global
    /// when possible. `fee-fixed` is a human decimal in `asset-id` units.
    /// `fee-percent-ppm` is ppm (`10_000` = 1%).
    /// `allow-unknown`: closed (false) requires the poster already know the
    /// next hop; open (true) lets anyone who lined the poster become their
    /// creditor. Applied on insert and update.
    set-forward-offer: func(
        next-hop: string,
        asset-id: u16,
        fee-fixed: string,
        fee-percent-ppm: u32,
        max-line-apr-ppm: u32,
        expires-at-seconds: u32,
        allow-unknown: bool,
    ) -> result<_, error>;

    /// Global path-forward offer for this asset (any next hop).
    /// `allow-unknown` is applied on insert and update; see `set-forward-offer`.
    set-global-forward-offer: func(
        asset-id: u16,
        fee-fixed: string,
        fee-percent-ppm: u32,
        max-line-apr-ppm: u32,
        expires-at-seconds: u32,
        allow-unknown: bool,
    ) -> result<_, error>;

    /// Remove a specific path-forward offer.
    remove-forward-offer: func(next-hop: string, asset-id: u16) -> result<_, error>;

    /// Remove global path-forward offer for this asset.
    remove-global-forward-offer: func(asset-id: u16) -> result<_, error>;

    /// Post a buy-claim offer for claims on a **specific** debtor.
    /// `fee-percent-ppm` is a signed spread: positive haircuts the seller,
    /// negative is a premium (`-50000` = 5% over face).
    set-buy-claim-offer: func(
        debtor: string,
        asset-id: u16,
        fee-fixed: string,
        fee-percent-ppm: s32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Global buy-claim offer for this asset (any lined debtor).
    set-global-buy-claim-offer: func(
        asset-id: u16,
        fee-fixed: string,
        fee-percent-ppm: s32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Flag-only `allow-unknown` update on a posted path-forward offer
    /// (does not re-post fees). Empty `next-hop` (or `"0"`) is the global
    /// offer. Closed (false): poster must have lined the next hop (limit 0
    /// is enough). Open (true): anyone who lined the poster can become
    /// their creditor.
    set-allow-unknown: func(
        next-hop: string,
        asset-id: u16,
        allow-unknown: bool,
    ) -> result<_, error>;

    /// Remove a specific buy-claim offer.
    remove-buy-claim-offer: func(debtor: string, asset-id: u16) -> result<_, error>;

    /// Remove global buy-claim offer for this asset.
    remove-global-buy-claim-offer: func(asset-id: u16) -> result<_, error>;

    /// Post a sell-claim offer for claims on a **specific** debtor.
    /// Signed spread: **positive is your profit** (`10000` = 1% over
    /// face); negative is a discount you will take.
    set-sell-claim-offer: func(
        debtor: string,
        asset-id: u16,
        fee-fixed: string,
        fee-percent-ppm: s32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Global sell-claim offer for this asset (any debtor the poster is owed by).
    set-global-sell-claim-offer: func(
        asset-id: u16,
        fee-fixed: string,
        fee-percent-ppm: s32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Remove a specific sell-claim offer.
    remove-sell-claim-offer: func(debtor: string, asset-id: u16) -> result<_, error>;

    /// Remove global sell-claim offer for this asset.
    remove-global-sell-claim-offer: func(asset-id: u16) -> result<_, error>;

    /// Sell claims on `debtor` to `buyer` under buyer's **buy** offer.
    /// `amount` is face (human decimal); seller receives face after fees as a
    /// claim on the buyer.
    sell-claim: func(
        buyer: string,
        debtor: string,
        asset-id: u16,
        amount: string,
    ) -> result<_, error>;

    /// Buy claims on `debtor` from `seller` under seller's **sell** offer.
    buy-claim: func(
        seller: string,
        debtor: string,
        asset-id: u16,
        amount: string,
    ) -> result<_, error>;

    /// Post a from→to FX offer. Others take it with `convert`. Path pay uses
    /// it to size a hop when you are the middle man. Fee is a human decimal in
    /// **from-asset** units. `to-rate` is how many **to-asset** units you get
    /// for 1 full **from-asset** unit (e.g. `"0.45"`). The plugin converts this
    /// to the chain `fx_rate` (RATE_SCALE fixed-point), including precisions.
    set-currency-policy: func(
        from-asset: u16,
        to-asset: u16,
        fee-fixed: string,
        to-rate: string,
        to-interest-rate-ppm: u32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Remove a from→to FX offer.
    remove-currency-policy: func(from-asset: u16, to-asset: u16) -> result<_, error>;

    /// Invoice (`kind` = 1): you are the payee; `counterparty` is who was
    /// billed (empty / `"0"` = anyone with a path may pay). Please-book
    /// (`kind` = 2): you ask `counterparty` (creditor) to deposit you.
    /// `amount` is a human decimal. `memo` max 80 bytes.
    create-request: func(
        kind: u8,
        counterparty: string,
        asset-id: u16,
        amount: string,
        memo: string,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Cancel an open request. Poster only.
    cancel-request: func(id: u32) -> result<_, error>;

    /// Book a deposit: sender receives value and credits `depositor`, then auto-nets.
    /// `amount` is a human decimal string.
    /// `request-id` 0 = none; otherwise a please-book you are fulfilling.
    deposit: func(
        depositor: string,
        asset-id: u16,
        amount: string,
        interest-rate-ppm: u32,
        request-id: u32,
    ) -> result<_, error>;

    /// Net mutual obligations with `counterparty` for `asset-id`.
    /// `max-amount` is a human decimal string.
    net: func(counterparty: string, asset-id: u16, max-amount: string) -> result<_, error>;

    /// Write off claims the sender holds on `debtor` (one-sided; debtor does
    /// not sign). `amount` is a human decimal, capped on chain at live
    /// exposure. Partial does not reset grace; principal to 0 closes the cycle.
    forgive: func(debtor: string, asset-id: u16, amount: string) -> result<_, error>;

    /// Take the counterparty's currency-policy offer and rebook leftover
    /// from-asset on this pair into to-asset. Amounts are human decimals.
    convert: func(
        counterparty: string,
        from-asset: u16,
        to-asset: u16,
        amount-from: string,
        min-to: string,
    ) -> result<_, error>;

    /// Multi-hop path payment. Each hop is (account, asset-id).
    /// Amounts are human decimal strings in the first/last hop assets respectively.
    /// `request-id` 0 = none; otherwise an invoice you are fulfilling (last hop
    /// must be the payee).
    path-pay: func(
        hops: list<path-hop>,
        amount: string,
        min-return: string,
        request-id: u32,
    ) -> result<_, error>;

    /// Pay a live invoice: walk hops backward from remaining, send the
    /// smallest amount that clears the bill if that is ≤ `max-spend`.
    /// `max-spend` is a human decimal in the first hop's asset. Last hop
    /// must be the payee; any account with a path may pay.
    pay-inv: func(
        hops: list<path-hop>,
        max-spend: string,
        request-id: u32,
    ) -> result<_, error>;

    /// Post a cash quote: Banx `asset-id` ↔ Tokens `token-id`.
    /// `is-out` true: taker draws Banx, receives tokens. False: taker sends
    /// tokens, books Banx onto the poster.
    /// `fee-fixed` is a human decimal in Banx units (out) or token units (in).
    /// `to-rate` is how many **to** units per 1 **from** unit (same as
    /// `set-currency-policy`).
    set-cash-quote: func(
        asset-id: u16,
        token-id: u32,
        is-out: bool,
        fee-fixed: string,
        to-rate: string,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Remove a cash quote.
    remove-cash-quote: func(asset-id: u16, token-id: u32, is-out: bool) -> result<_, error>;

    /// Move tokens already credited to Banx into `{sender}/{token-id}`.
    /// The UI credits Banx first, then calls this.
    cash-fund: func(token-id: u32, amount: string) -> result<_, error>;

    /// Withdraw tokens from `{sender}/{token-id}` on Banx.
    cash-withdraw: func(token-id: u32, amount: string) -> result<_, error>;

    /// Draw Banx on `cashier`'s line; receive tokens from their vault.
    /// `amount-banx` / `min-tokens` are human decimals.
    cash-out: func(
        cashier: string,
        asset-id: u16,
        token-id: u32,
        amount-banx: string,
        min-tokens: string,
    ) -> result<_, error>;

    /// Send tokens from the sender's `{sender}/{token-id}` vault (filled by
    /// `cash-fund`) at `cashier`'s in quote.
    /// `amount-tokens` / `min-banx` are human decimals.
    cash-in: func(
        cashier: string,
        asset-id: u16,
        token-id: u32,
        amount-tokens: string,
        min-banx: string,
    ) -> result<_, error>;

    /// Discover a multi-hop path from `from-account` to `to-account` (TokenSwap-style
    /// max amount_out search over credit lines / forward offers / FX). Uses a scoped GraphQL
    /// subgraph around the two endpoints — not a full-network dump.
    ///
    /// - `exact-out = false` (default): `amount` is what you send (`from-asset`);
    ///   fees reduce what the payee receives.
    /// - `exact-out = true`: `amount` is what the payee should receive (requires
    ///   `to-asset`); quote finds the minimum send so you absorb hop/FX fees.
    ///
    /// `to-asset` empty/none → any final asset (exact-in only); otherwise require
    /// that asset on the last hop.
    quote-path: func(
        from-account: string,
        to-account: string,
        amount: string,
        from-asset: u16,
        to-asset: option<u16>,
        max-hops: u8,
        exact-out: bool,
    ) -> result<path-quote, error>;

    /// Create a single-use network+Banx invite that extends a credit line to the claimee.
    /// `limit` is a human decimal. Returns the invite token for the claim URL.
    create-invite: func(
        asset-id: u16,
        limit: string,
        deplete-on-debit: bool,
        interest-rate-ppm: u32,
        grace-seconds: u32,
    ) -> result<created-invite, error>;

    /// Revoke a Banx invite. Inviter only.
    delete-invite: func(invite-id: u32) -> result<_, error>;
}

world imports {
    import api;
    import helpers;
}
