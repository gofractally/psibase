package banx:plugin;

interface types {
    record path-hop {
        account: string,
        asset-id: u16,
    }

    /// Result of off-chain multi-hop path discovery for `path-pay`.
    record path-quote {
        hops: list<path-hop>,
        /// Amount to draw on the first hop (human decimal in first hop asset).
        amount-in: string,
        /// Estimated residual after fees (human decimal in last hop asset).
        amount-out: string,
        /// Suggested min-return for `path-pay` (human decimal in last hop asset).
        min-return: string,
    }
}

interface helpers {
    use host:types/types.{error};

    /// Convert a human decimal string (e.g. `"1.45"`) to raw quantity units for `asset-id`.
    /// Looks up asset precision via Banx GraphQL.
    /// Fractions may not exceed the asset's precision; shorter fractions are padded.
    decimal-to-quantity: func(asset-id: u16, amount: string) -> result<u64, error>;

    /// Convert raw quantity units to a decimal string for `asset-id` (e.g. `14500` → `"1.4500"` at 4 dp).
    quantity-to-decimal: func(asset-id: u16, amount: u64) -> result<string, error>;
}

interface api {
    use host:types/types.{error};
    use types.{path-hop, path-quote};

    /// Creditor posts/updates a credit line to `debtor` in `asset-id`.
    /// `limit` is a human decimal string (e.g. `"100.00"`).
    /// `interest-rate-ppm` is APR in ppm (10000 = 1%).
    set-credit-line: func(
        debtor: string,
        asset-id: u16,
        limit: string,
        deplete-on-debit: bool,
        interest-rate-ppm: u32,
    ) -> result<_, error>;

    /// Intermediate posts a same-asset path-routing policy toward a **specific**
    /// `creditor` (optional override). Prefer `set-global-routing-policy`.
    /// `hop-fee-fixed` is a human decimal in `asset-id` units.
    /// `hop-fee-percent-ppm` is a percent fee in ppm (`10_000` = 1%).
    set-routing-policy: func(
        creditor: string,
        asset-id: u16,
        hop-fee-fixed: string,
        hop-fee-percent-ppm: u32,
        max-accept-rate-ppm: u32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Intermediate posts **default** routing for this asset toward any next-hop
    /// that has extended them a credit line.
    set-global-routing-policy: func(
        asset-id: u16,
        hop-fee-fixed: string,
        hop-fee-percent-ppm: u32,
        max-accept-rate-ppm: u32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Remove a per-creditor routing override (if present).
    remove-routing-policy: func(creditor: string, asset-id: u16) -> result<_, error>;

    /// Remove global routing for this asset (if present).
    remove-global-routing-policy: func(asset-id: u16) -> result<_, error>;

    /// Debtor posts a convert quote from `from-asset` → `to-asset`.
    /// Fee is a human decimal in **from-asset** units.
    /// `to-rate` is how many **to-asset** units you get for 1 full **from-asset**
    /// unit (e.g. `"0.45"` means 1 from → 0.45 to). The plugin converts this to
    /// the chain `fx_rate` (RATE_SCALE fixed-point), including asset precisions.
    set-currency-policy: func(
        from-asset: u16,
        to-asset: u16,
        fee-fixed: string,
        to-rate: string,
        to-interest-rate-ppm: u32,
        expires-at-seconds: u32,
    ) -> result<_, error>;

    /// Book a deposit: sender receives value and credits `depositor`, then auto-nets.
    /// `amount` is a human decimal string.
    deposit: func(
        depositor: string,
        asset-id: u16,
        amount: string,
        interest-rate-ppm: u32,
    ) -> result<_, error>;

    /// Net mutual obligations with `counterparty` for `asset-id`.
    /// `max-amount` is a human decimal string.
    net: func(counterparty: string, asset-id: u16, max-amount: string) -> result<_, error>;

    /// Convert existing debt via a debtor's currency policy.
    /// Amounts are human decimal strings in their respective assets.
    convert: func(
        counterparty: string,
        from-asset: u16,
        to-asset: u16,
        amount-from: string,
        min-to: string,
    ) -> result<_, error>;

    /// Multi-hop path payment. Each hop is (account, asset-id).
    /// Amounts are human decimal strings in the first/last hop assets respectively.
    path-pay: func(
        hops: list<path-hop>,
        amount: string,
        min-return: string,
    ) -> result<_, error>;

    /// Discover a multi-hop path from `from-account` to `to-account` (TokenSwap-style
    /// max-residual search over credit lines / routing / FX). Uses a scoped GraphQL
    /// subgraph around the two endpoints — not a full-network dump.
    ///
    /// - `exact-out = false` (default): `amount` is what you send (`from-asset`);
    ///   fees reduce what the payee receives.
    /// - `exact-out = true`: `amount` is what the payee should receive (requires
    ///   `to-asset`); quote finds the minimum send so you absorb hop/FX fees.
    ///
    /// `to-asset` empty/none → any final asset (exact-in only); otherwise require
    /// that asset on the last hop.
    quote-path: func(
        from-account: string,
        to-account: string,
        amount: string,
        from-asset: u16,
        to-asset: option<u16>,
        max-hops: u8,
        exact-out: bool,
    ) -> result<path-quote, error>;

    /// Accrue interest on a directed pair/asset.
    accrue: func(creditor: string, debtor: string, asset-id: u16) -> result<_, error>;
}

world imports {
    import api;
    import helpers;
}
