package branding:plugin;

interface types {
    /// A network logo image. Must be PNG, JPEG, or WebP, and no larger than 32 KB.
    record logo {
        content-type: string,
        content: list<u8>,
    }
}

interface api {
    use host:types/types.{error};
    use types.{logo};

    /// Sets the network name for the current network
    ///
    /// The specified name must be a valid account name.
    /// The specified name must either:
    /// * Not yet exist as an account, or
    /// * Exist but be owned by the "branding" account (using auth-delegate)
    ///
    /// The specified network name will reverse proxy its content to the
    /// homepage service.
    set-network-name: func(name: string);

    /// Sets the logo for the network, served at `/network_logo` on the branding subdomain
    set-logo: func(logo: logo) -> result<_, error>;
}

interface queries {
    use host:types/types.{error};

    /// Get the current network name
    get-network-name: func() -> result<string, error>;
}

world imports {
    import types;
    import api;
    import queries;
}
