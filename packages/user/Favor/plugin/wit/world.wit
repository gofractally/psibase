package favor:plugin;
interface api {
    use host:types/types.{error};
    set-line: func(peer: string, symbol: string, limit: string, fee-ppm: u32, forwarding: bool) -> result<_, error>;
    set-receiving: func(request-only: bool) -> result<_, error>;
    create-request: func(hash: string, symbol: string, amount: string, expires-at: string, payer: option<string>) -> result<_, error>;
    revoke-request: func(hash: string) -> result<_, error>;
    pay: func(payee: string, symbol: string, amount: string, max-total: string, encoded-route: string, reference: string, memo: string) -> result<_, error>;
    settle: func(peer: string, symbol: string, amount: string, nonce: string) -> result<_, error>;
}
interface authorized {
    use host:types/types.{error};
    graphql: func(query: string) -> result<string, error>;
}
world imports { import api; import authorized; }
