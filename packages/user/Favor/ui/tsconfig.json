{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "paths": {
            "@psibase/common-lib": ["./src/psibase.d.ts"]
        }
    },
    "include": ["src"]
}
