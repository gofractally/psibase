[
    {
        "sender": "homepage",
        "service": "sites",
        "method": "enablespa",
        "data": {
            "enable": true
        }
    },
    {
        "sender": "homepage",
        "service": "sites",
        "method": "setcsp",
        "data": {
            "path": "*",
            "csp": "default-src 'self';script-src 'self';style-src 'self' 'unsafe-inline';img-src 'self' data: profiles.{{root}}/avatar/ branding.{{root}};font-src 'self';connect-src 'self' profiles.{{root}};frame-src supervisor.{{root}};frame-ancestors 'self';base-uri 'none';form-action 'self';object-src 'none';"
        }
    },
    {
        "sender": "homepage",
        "service": "http",
        "method": "setRedirect",
        "data": {
            "destination": "network"
        }
    },
    {
        "sender": "accounts",
        "service": "accounts",
        "method": "preapproveAcc",
        "data": {
            "name": "network"
        }
    },
    {
        "sender": "branding",
        "service": "branding",
        "method": "setNetworkName",
        "data": {
            "name": "network"
        }
    }
]
