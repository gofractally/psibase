package host:login-prompt;

interface api {
    use host:types/types.{error};
    use host:accounts/admin.{credential};
    use types.{import-context};
    use tokens:plugin/types.{system-token-info, user-balance};
    use name-market:plugin/types.{markets-overview};

    /// Returns whether or not an account can currently be created.
    ///
    /// An account can be created if either of the following is true:
    /// * The user is already logged into the top-level app with an account
    /// * The user is responding to an invite that can be redeemed to create an account
    can-create-account: func() -> bool;

    /// Import a pre-existing account(s) to this device.
    ///
    /// Full docs available at `host:accounts/admin.import-existing`.
    import-existing: func(credentials: list<credential>) -> result<_, list<tuple<string, error>>>;

    /// Creates a new account, returns the private key used to authorize it.
    ///
    /// The new account will NOT be automatically imported onto this device. It is required
    ///   to explicitly import the account using the `import-existing` function.
    ///
    /// If there is already a user logged into the top-level app, then the account will be
    ///   created by that user. Otherwise, if there is currently an active invite that can
    ///   be redeemed to create an account, then the invite will be used. If neither condition
    ///   is met, then the attempt to create an account will fail.
    create-account: func(account-name: string) -> result<string, error>;

    /// Purchases a premium account name, claims it, configures auth-sig, and returns the new account's private key.
    ///
    /// The account is not imported onto this device.
    create-premium: func(account-name: string, max-cost: string) -> result<string, error>;

    /// Will connect the specified account with the active app, if not already
    ///   connected, and login if `login` is true.
    /// The account must already be imported on this device.
    /// If there is currently an active invite, calling this will automatically accept it.
    connect-account: func(account: string, login: bool);

    /// Reads the active `importnew` prompt context.
    ///
    /// Callable only by this app, and only while that prompt is live.
    get-import-context: func() -> import-context;

    /// Fetches the configured system token.
    get-system-token: func() -> result<option<system-token-info>, error>;

    /// Fetches token balances for a user.
    get-user-balances: func(user: string) -> result<list<user-balance>, error>;

    /// Whether a premium account name can currently be purchased.
    ///
    /// Distinct from `can-create-account`, which reports whether the user is
    /// logged in or holding an invite that can create an account.
    can-buy-account: func() -> bool;

    /// Returns configured name markets and current ask prices.
    get-markets-overview: func() -> result<markets-overview, error>;
}
