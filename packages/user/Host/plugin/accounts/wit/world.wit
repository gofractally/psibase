package host:accounts;

interface api {
    /// Returns true if there is a user logged in to the currently active top-level application.
    is-logged-in: func() -> bool;

    /// Gets the account name of the user logged into the active application.
    /// May also return None if no user is logged in.
    get-current-user: func() -> option<string>;
}

/// This interface is only available to the top-level app, or its plugin.
/// The "top-level" app is the app with which the user is directly interacting.
interface active-app {
    use host:types/types.{error};

    /// Directly log in a user by their account name.
    /// The user must have already been connected to the app.
    login: func(user: string) -> result<_, error>;

    /// Logs out the currently logged-in user.
    logout: func() -> result<_, error>;

    /// Disconnects a previously connected account from the active app
    disconnect: func(account: string) -> result<_, error>;

    /// Retrieves a list of accounts that the user has connected to this app.
    /// The user may only log in to accounts that have been connected.
    get-connected-accounts: func() -> result<list<string>, error>;

    /// Prompts the user to connect an account to the active app
    connect-account: func() -> result<_, error>;
}

/// Callable by the accounts plugin and by host.
interface admin {
    use host:types/types.{error, pem};

    record credential {
        /// The name of the account
        account: string,
        /// The private key in PEM format used to authorize the account
        key: pem,
    }

    /// Import a pre-existing account(s) to this device.
    /// Callable only by host and homepage.
    ///
    /// Importing an account requires both the name of the account and its corresponding private
    /// key in PEM format. The private key will be verified to ensure that it can be used to
    /// authorize the account.
    ///
    /// Returns:
    /// * On success, returns nothing,
    /// * If any credentials fail validation, returns a list of tuples containing the account name
    ///   and the error that caused the failure.
    ///
    /// Any credentials that fails validation will not be imported.
    import-existing: func(credentials: list<credential>) -> result<_, list<tuple<string, error>>>;

    /// Takes over an account that the supervisor has just created: stores its key on this
    /// device and logs the account in to the active app.
    /// Callable only by the supervisor.
    ///
    /// Parameters:
    /// * `account`: The name of an existing account that uses the `auth-sig` auth service
    /// * `private-key`: The P-256 or secp256k1 private key of the account, PKCS #8 in PEM format
    ///
    /// The account and key are verified before anything is stored. On success:
    /// * the key is in the key vault and the account is known to this device, as after
    ///   `import-existing`,
    /// * the active app is one of the account's connected apps, and
    /// * the account is logged in to the active app, as after `login`.
    ///
    /// If the login fails after the key was verified, the key stays imported and the account
    /// stays known to this device, but it is neither connected nor logged in to the active app
    /// and whoever was logged in to it before still is.
    adopt-account: func(account: string, private-key: string) -> result<_, error>;

    /// As `adopt-account`, for the app that is named instead of the active app. For a
    /// page of the supervisor that is not a prompt (the sign-in page), which has no
    /// active app of its own.
    /// Callable only by the supervisor.
    ///
    /// Parameters:
    /// * `app`: The app to log the account in to
    /// * `account`: The name of an existing account that uses the `auth-sig` auth service
    /// * `private-key`: The account's ACTIVE private key (P-256 or secp256k1), PKCS #8 in
    ///   PEM format. It is compared with the account's active key as a curve point.
    ///
    /// The account and key are verified before anything is stored. On success the key is
    /// in the key vault, the account is known to this device, `app` is one of its
    /// connected apps, and it is logged in to `app` (query token and app cookie
    /// included). If the login fails after the key was verified, the key stays imported
    /// and the account stays known to this device, but it is neither connected nor logged
    /// in to `app`, and whoever was logged in to it before still is.
    adopt-account-for: func(app: string, account: string, private-key: string) -> result<_, error>;

    /// The accounts known to this device: those that were imported or adopted here.
    /// Callable only by the supervisor.
    known-accounts: func() -> list<string>;

    /// Makes an account that is already known to this device the logged-in user of `app`,
    /// and connects it to `app`. For the account switcher.
    /// Callable only by the supervisor.
    login-for: func(app: string, account: string) -> result<_, error>;

    /// Logs the current user out of `app`. Nothing happens if nobody is logged in.
    /// Callable only by the supervisor.
    logout-for: func(app: string);

    /// Removes an account from this device: it is logged out of and disconnected from
    /// every app it was connected to, it is no longer a known account, and the private
    /// key stored for its current active key is deleted from the key vault. Nothing on
    /// chain changes. Nothing happens for an account that is not known here.
    /// Callable only by the supervisor.
    forget-account: func(account: string);

    /// Logs the user into the specified app and connects them to it
    login: func(user: string, app: string) -> result<_, error>;

    /// Logs out the user logged into the specified app
    logout: func(app: string);

    /// Connects the account to the specified app
    connect: func(account: string, app: string);

    /// Disconnects the account from the specified app, logging it out if logged in
    disconnect: func(account: string, app: string);

    /// Gets the accounts connected to the specified app
    get-connected-accounts: func(app: string) -> list<string>;

    /// Adds the specified app to the user's connected apps
    add-connected-app: func(user: string, app: string);

    /// Removes the specified app from the user's connected apps
    remove-connected-app: func(user: string, app: string);

    /// Gets the names of all apps to which the user has connected
    get-connected-apps: func(user: string) -> list<string>;
}

world imports {
    import api;
}
