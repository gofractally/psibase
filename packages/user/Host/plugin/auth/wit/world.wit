package host:auth;

interface api {
    /// Persist the token and plant the auth cookie for `user` on `app`.
    /// Host-only. The caller obtains the token (cache hit or mint).
    set-session: func(user: string, app: string, token: string);

    /// Clear credentials for `user` on `app`.
    /// Host-only.
    clear-session: func(user: string, app: string);

    /// Privileged callers can get the query token to make calls on the user's behalf.
    /// Host + supervisor.
    get-active-query-token: func(app: string, user: string) -> option<string>;
}

world imports {
    import api;
}
