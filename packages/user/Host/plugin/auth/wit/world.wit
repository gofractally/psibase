package host:auth;

interface api {
    use host:types/types.{error};

    /// Returns true if a query token for `user` on `app` is already cached.
    has-query-token: func(user: string, app: string) -> bool;

    /// Plant credentials for `user` on `app`.
    /// `token` is required when no query token is cached for this user and app.
    set-session: func(user: string, app: string, token: option<string>) -> result<_, error>;

    /// Tear down credentials for `user` on `app`.
    clear-session: func(user: string, app: string);

    /// Privileged callers can get the query token to make calls on the user's behalf.
    get-active-query-token: func(app: string, user: string) -> option<string>;
}

world imports {
    import api;
}
