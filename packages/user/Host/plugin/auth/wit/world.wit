package host:auth;

interface api {
    use host:types/types.{claim, error};

    /// Notify of new logged in user.
    ///
    /// If no query token is cached for `(user, app)`, mints one via
    /// `get-query-token`. `claim` proves authorization when minting;
    /// pass `none` when the auth service does not require a signed
    /// login (e.g. `auth-any`).
    ///
    /// Only callable by `accounts`.
    set-logged-in-user: func(
        user: string,
        app: string,
        claim: option<claim>,
    ) -> result<_, error>;

    /// Notify of user logout
    log-out-user: func(user: string, app: string);

    /// Privileged apps can get the query token to make calls on user's behalf
    get-active-query-token: func(app: string, user: string) -> option<string>;
}

world imports {
    import api;
}
