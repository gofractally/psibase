package supervisor:bridge;

interface intf {
    get-client-key: func() -> list<u8>;
}

interface database {
    /// `debug-key` is the plaintext `{mode}:{service}:{identifier}:{key}`.
    /// The host may name it when the key is absent. It is not sent to the node.
    get: func(duration: u8, key: string, debug-key: string) -> option<list<u8>>;
    set: func(duration: u8, key: string, value: list<u8>);
    remove: func(duration: u8, key: string);
}

world imports {
    import intf;
    import database;
}
