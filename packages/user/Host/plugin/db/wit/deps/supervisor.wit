package supervisor:bridge;

interface intf {
    get-client-key: func() -> list<u8>;
}

/// Extra debug data the platform may print when a database operation fails.
interface database {
    get: func(duration: u8, key: string, debug-data: string) -> option<list<u8>>;
    set: func(duration: u8, key: string, value: list<u8>, debug-data: string);
    remove: func(duration: u8, key: string, debug-data: string);
}

world imports {
    import intf;
    import database;
}
