package supervisor:bridge;

interface types {
    // Anchor shared types in host:types so wac can merge the implicit
    // supervisor:bridge/intf import across host plugins (crypto's copy
    // uses host:types/types.error directly).
    use host:types/types.{error, plugin-id};

    variant body-types {
        bytes(list<u8>),
        json(string),
        text(string),
        graphql(string),
    }

    record header {
        key: string,
        value: string,
    }

    record http-request {
        uri: string,
        method: string,
        headers: list<header>,
        body: option<body-types>,
    }

    record http-response {
        status: u32,
        headers: list<header>,
        body: option<body-types>,
    }
}

interface intf {
    use types.{http-request, http-response, error, plugin-id};

    send-request: func(req: http-request, with-credentials: bool) -> result<http-response, error>;
}

world imports {
    import intf;
}
