package host:prompt;

interface admin {
    use host:types/types.{error};

    /// The details of the currently active prompt
    record prompt-details {
        prompt-app: string,
        prompt-name: string,
        active-app: string,
        created: string,
        packed-context: option<list<u8>>,
    }

    /// Used by the supervisor app to facilitate the interaction with the user.
    /// Nothing if no prompt is active: a page of the supervisor that is not a
    /// prompt (the sign-in page) asks too.
    get-active-prompt: func() -> option<prompt-details>;
} 

world impl {
    include host:client/imports;
    include host:db/imports;
    include supervisor:bridge/imports;

    export admin;
    export api;
}
