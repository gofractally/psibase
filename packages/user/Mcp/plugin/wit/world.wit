/// Parent/owner side of X-MCP agents: list the agent transactions that need
/// your approval, and approve them (optionally granting the agent the
/// missing service/method pairs so a repeat auto-executes).
/// Also: mint an agent account, bootstrap AuthDyn management, and (for the
/// agent signing page) propose actions as a managed account.
package mcp:plugin;

interface approvals {
    use host:types/types.{error};

    /// JSON array of `{ pending: { account, id, txid, proposer, actions }, missing: [string] }`
    /// for every managed account whose parent is the logged-in user.
    /// Uses the logged-in user's query token, so only the owner can read it.
    needs-approval: func() -> result<string, error>;

    /// The logged-in parent accepts staged tx `id` of managed `account`.
    approve: func(account: string, id: u32) -> result<_, error>;

    /// In one transaction: grant every missing service/method pair of staged tx
    /// `id` to the agent of `account`, then accept it.
    approve-and-grant: func(account: string, id: u32) -> result<_, error>;
}

interface setup {
    use host:types/types.{error, pem};

    /// Create a new AuthSig agent account (logged-in parent pays/signs).
    /// Returns the new private key PEM; caller must save/confirm it.
    create-agent-account: func(agent-name: string) -> result<pem, error>;

    /// True if `private-key` authorizes `agent-name` (post-create ownership check).
    confirm-agent-key: func(agent-name: string, private-key: pem) -> result<bool, error>;

    /// Parent wires a fresh managed account under AuthDyn/`mcp` with `agent-name`.
    bootstrap: func(managed-name: string, agent-name: string) -> result<_, error>;

    /// JSON array of AgentCfg rows where the logged-in user is parent.
    my-agents: func() -> result<string, error>;
}

interface agent-sign {
    use host:types/types.{error, pem};

    /// Import agent credentials into this browser's vault and connect them to mcp.
    import-agent: func(account: string, private-key: pem) -> result<_, error>;

    /// Propose (and implicitly accept) actions as `managed`.
    /// `actions-json` is a JSON array of
    /// `{ "service": string, "method": string, "rawData": "<hex>" }`.
    /// Covered allowlisted actions auto-execute; otherwise call `track`
    /// afterward (or use the parent approvals UI). Returns 0 (id not
    /// surfaced by transact propose yet).
    propose-as: func(managed: string, actions-json: string) -> result<u32, error>;

    /// Convenience: propose `profiles.setProfile` as `managed`.
    propose-set-profile: func(managed: string, display-name: string, bio: string) -> result<_, error>;

    /// Record staged tx `id` on the parent's needs-approval list.
    track: func(id: u32) -> result<_, error>;
}

world imports {
    import approvals;
    import setup;
    import agent-sign;
}
