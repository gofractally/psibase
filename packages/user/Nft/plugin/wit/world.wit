package nft:plugin;

interface issuer {
    use host:types/types.{error};


    /// Mint a new NFT.
    ///
    /// Returns the id of NFT.
    mint: func() -> result<u32, error>;
}


interface user {

    use host:types/types.{error};

    /// Credit NFT to a recipient.
    ///
    /// Arguments
    /// * `nft_id`   - Unique NFT identifier
    /// * `receiver` - Recipient account
    /// * `memo`     - Memo describing the credit
    ///
    /// Places the NFT in the shared table until it is debited
    credit: func(nft-id: u32, receiver: string, memo: string) -> result<_, error>;

    /// Transfer an NFT to a recipient.
    ///
    /// Arguments
    /// * `nft_id`   - Unique NFT identifier
    /// * `receiver` - Recipient account
    /// * `memo`     - Memo describing the transfer
    ///
    /// Credits the NFT, then debits it when the recipient has auto-debit enabled
    transfer: func(nft-id: u32, receiver: string, memo: string) -> result<_, error>;

    /// Cancel a pending shared-balance credit.
    ///
    /// Arguments
    /// * `nft_id` - Unique NFT identifier
    /// * `memo`     - Memo describing the uncredit
    uncredit: func(nft-id: u32, memo: string) -> result<_, error>;

    /// Move tokens from shared balance into the debitor's account balance.
    ///
    /// Arguments
    /// * `nft_id` - Unique NFT identifier
    /// * `memo`     - Memo describing the debit
    debit: func(nft-id: u32, memo: string) -> result<_, error>;

    /// Burn NFT from the caller's posession.
    ///
    /// Arguments
    /// * `nft_id`   - Unique NFT identifier
    burn: func(nft-id: u32) -> result<_, error>;


}

interface user-config {
    use host:types/types.{error};

    /// Enable or disable auto debit globally for the caller.
    ///
    /// Arguments
    /// * `enable` - `true` to enable auto debit, `false` to disable auto debit
    enable-user-auto-debit: func(enable: bool) -> result<_, error>;
}

/// Interface that makes authorized queries to this app's http server.
interface authorized {
    use host:types/types.{error};

    /// Executes a GraphQL query against this app's http server.
    ///
    /// Arguments
    /// * `query` - GraphQL query to execute
    ///
    /// Returns the result of the query as a string.
    graphql: func(query: string) -> result<string, error>;
}

world imports {
    import issuer;
    import user;
    import user-config;
    import authorized;
}
