[
  {
    "sender": "supervisor",
    "service": "sites",
    "method": "setcsp",
    "data": {
      "path": "*",
      "csp": "default-src 'self';script-src 'self' 'wasm-unsafe-eval' blob:;style-src 'self' 'unsafe-inline';img-src 'self' data: {{root}} *.{{root}};font-src 'self';connect-src 'self' blob: {{root}} *.{{root}};frame-src {{root}} *.{{root}};frame-ancestors {{root}} *.{{root}};base-uri 'none';form-action 'self';object-src 'none';"
    }
  }
]
