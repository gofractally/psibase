package psibase:plugin;

world plugin-imports {
    include host:types/imports;
    include host:call-context/imports;
    include host:authed-http/imports;
    include host:crypto/imports;
    include host:db/imports;
    include host:prompt/imports;
    
    import permissions:plugin/api;
    import permissions:plugin/types;
    import transact:plugin/intf;
}
